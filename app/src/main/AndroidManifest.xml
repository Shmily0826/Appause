<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        FOREGROUND_SERVICE: needed to show the persistent monitoring notification.
        POST_NOTIFICATIONS: required on Android 13+ (API 33) to post notifications.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
        SYSTEM_ALERT_WINDOW: TYPE_APPLICATION_OVERLAY window for the cooldown
        screen. TYPE_ACCESSIBILITY_OVERLAY is rejected on some OEM ROMs
        (HyperOS/Android 16); TYPE_APPLICATION_OVERLAY draws above ALL app
        tasks so apps like 小红书 can't cover it by re-fronting themselves.
        Granted by the user via Settings -> 显示悬浮窗 (draw over other apps).
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!--
        INTERNET: used ONLY for the one-time Pro activation handshake
        (/api/redeem). Daily app operation remains fully offline — no telemetry,
        no account, no background network calls.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        PACKAGE_USAGE_STATS: used ONLY to confirm which app is genuinely in
        the foreground before showing the pause screen. This is what stops
        "notification false positives" — when an app (e.g. Bilibili) has a
        "now playing" notification in the shade, the accessibility event
        reports its package even though it isn't actually open. We cross-check
        with UsageStatsManager and skip the pause when the app isn't really
        on top. Granted once by the user in Settings -> Apps -> Special app
        access -> Usage access. No data leaves the device.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Package visibility (Android 11+, API 30+):
        Apps cannot see other installed apps by default.
        We declare which apps we need to query here.
        MAIN + LAUNCHER = all apps with a home screen icon.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AppauseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Appause">

        <!-- Main Activity: hosts the Compose navigation graph -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Appause">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            PauseActivity: full-screen cooldown overlay.
            Launched from AccessibilityService with FLAG_ACTIVITY_NEW_TASK.
            Separate from MainActivity because the Service has no access
            to the main Activity's NavController.
        -->
        <activity
            android:name=".ui.pause.PauseActivity"
            android:exported="false"
            android:theme="@style/Theme.Appause"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!--
            Receiver for AlarmManager fallback launch of PauseActivity.
            On some OEM ROMs (e.g., MIUI), startActivity() from AccessibilityService
            is silently deprioritized. AlarmManager has higher system authority
            and reliably brings the Activity to the foreground.
        -->
        <receiver
            android:name=".service.PauseAlarmReceiver"
            android:exported="false" />

        <!--
            FileProvider: used ONLY by the debug Diagnostics screen to share the
            log report as a file attachment. Exposes just cache/logs/ (see
            res/xml/file_paths.xml) and is not exported.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            AccessibilityService: detects foreground app changes.
            Must be manually enabled by the user in system settings.
            Permission BIND_ACCESSIBILITY_SERVICE is required by the system.
        -->
        <service
            android:name=".service.AppauseAccessibilityService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- Required for foregroundServiceType="specialUse" on Android 14+ -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="accessibility_app_monitoring" />
        </service>

    </application>

</manifest>
