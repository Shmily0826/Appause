<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths.

    Only the app's own cache/logs/ folder is exposed, and only the diagnostics
    report is ever written there. This lets the debug Diagnostics screen share a
    log file through the system share sheet (QQ, email, ...) without needing
    storage permissions and without exposing anything else.
-->
<paths>
    <cache-path
        name="logs"
        path="logs/" />
</paths>
