    <!-- Settings: permission explanations and open-source statement -->
    <string name="permissions_why_title">Why does Appause need these permissions?</string>
    <string name="permissions_why_intro">Appause does not read your messages, browsing history, or account info, and does not upload any data to a server. All permissions are used locally only.</string>
    <string name="permissions_why_accessibility">Accessibility service — detects which app is currently in the foreground so Appause can show the pause screen when a blocked app is opened.</string>
    <string name="permissions_why_overlay">Display over other apps — optional. The new version uses an accessibility overlay, so this is usually not needed; if the pause screen is hidden or covered, try enabling it.</string>
    <string name="permissions_why_battery">Battery optimization exemption — keeps the background service alive so interceptions continue to work.</string>
    <string name="permissions_why_usage">Usage access — confirms the real foreground app. Without it, Recents and app switching can trigger the pause screen by mistake.</string>
    <string name="open_source_footer_title">Open source &amp; auditable</string>
    <string name="open_source_footer_body">Appause is released under the MIT license and its source code is available on GitHub. No personal data is uploaded, no account is required, and there is no malicious code or ad tracking.</string>
    <string name="github_repo_button">View GitHub repo</string>
    <string name="github_repo_url">https://github.com/Shmily0826/Appause</string>
    <string name="overlay_granted">Granted — the pause screen can overlay on top</string>
    <string name="overlay_not_granted">Not granted — pause screen may not show on some devices</string>
    <string name="overlay_required_title">"Display over other apps" permission required</string>
    <string name="overlay_required_desc">Without this permission the pause screen may not appear on phones like Xiaomi. Tap to open settings.</string>
    <string name="onboarding_overlay_title">Display over other apps (optional)</string>
    <string name="onboarding_overlay_desc">Optional permission. The new version draws the pause screen with an accessibility overlay, so this is usually not needed. If the pause screen does not appear, or interception is not working, come back here and enable it, then try again.</string>
    <string name="onboarding_overlay_open">Open system settings</string>
    <string name="onboarding_overlay_on">Enabled.</string>
    <string name="onboarding_overlay_off">Not enabled yet (optional). If the pause screen does not show, you can enable it here.</string>
    <string name="onboarding_usage_title">Enable "Usage access"</string>
    <string name="onboarding_usage_desc">Lets Appause accurately tell which app is truly open right now. Without it, opening Recents or switching apps can wrongly trigger the pause screen.</string>
