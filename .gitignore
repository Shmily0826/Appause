# Built files
*.iml
*.apk
*.ap_
*.aab

# Build directories
build/
*/build/
.kotlin/

# Local release output (APKs you keep for sideloading; never commit to git)
# 2026-10-03: dropped the !output/screenshots/ and !output/appause-icon.png exceptions.
# The 4 screenshots were superseded by images/screenshots/{en,zh}/ and referenced
# nowhere; output/appause-icon.png never existed. Both are gone from the repo.
output/*

# Local configuration
local.properties

# Gradle
.gradle/
gradle-app.setting

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Signed files
*.jks
*.keystore

# Generated
captures/
__pycache__/
scripts/__pycache__/

# Signing (never commit keys or signing configs)
signing.properties
key.properties
*.p12
*.pfx
*.keystore.*

# Heap dumps
*.hprof

# Agent / internal tooling (not part of the app)
.workbuddy/
.tools/

# Cloudflare Worker (Plan B activation server)
worker/node_modules/
worker/.wrangler/
# local secrets (never commit)
worker/.dev.vars
worker/wrangler.toml.local

# Stray design-skill variant templates (not part of Appause)
hallmark-variants/
taste-variants/

# Generated activation codes (valid redeemable codes once seeded into KV — never commit)
worker/codes.batch.json
worker/codes.txt

# Screenshot-script debug output (root of images/screenshots/ only — keeps en/ and zh/ subdirs)
images/screenshots/*.png
images/screenshots/*.xml

# Stray dir with a Windows reserved name, created by wrangler writing logs to
# "NUL" (2026-09-22). Normal Windows APIs cannot open or delete it; ignoring it
# stops git from warning on every scan. Delete it manually from Git Bash:
#   rm NUL/*.log && rmdir NUL
/NUL/

# Misc local debug artifacts (never part of the app)
shot.py
db_inspect/
db2/
.gradle-user/
.android-user/
.hallmark/

# Local tooling scratch dirs (agent/browser tool state, not project content)
.impeccable/
.playwright-cli/
.playwright-mcp/

# Stress-test evidence output: raw logcat, screenshots, and copies of the
# device database / persistent log. Contains real-device package names and
# usage records — never commit.
scripts/stress/evidence/
# Same thing at the repo root: the drivers default to a RELATIVE --evidence
# path, so running one from the repo root drops the tree next to gradlew
# instead of under scripts/stress/. Ignore the root copy too (2026-10-02).
/evidence/
