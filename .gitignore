!output/screenshots/
!output/screenshots/*.png
!output/appause-icon.png

# Local configuration
local.properties

# Gradle
.gradle/
gradle-app.setting

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Signed files
*.jks
*.keystore

# Generated
captures/
scripts/__pycache__/

# Signing (never commit keys or signing configs)
signing.properties
key.properties
*.p12
*.pfx
*.keystore.*

# Heap dumps
*.hprof

# Agent / internal tooling (not part of the app)
.workbuddy/

# Cloudflare Worker (Plan B activation server)
worker/node_modules/
worker/.wrangler/
worker/.dev.vars          # local secrets (never commit)
worker/wrangler.toml.local

# Stray design-skill variant templates (not part of Appause)
hallmark-variants/
taste-variants/
