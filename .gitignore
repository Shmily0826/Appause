# Built files
*.iml
*.apk
*.ap_
*.aab

# Build directories
build/
*/build/
.kotlin/

# Local release output (APKs you keep for sideloading; never commit to git)
output/*
# Exception: marketing screenshots + app icon for GitHub Pages (must be published)
!output/screenshots/
!output/screenshots/*.png
!output/appause-icon.png

# Local configuration
local.properties

# Gradle
.gradle/
gradle-app.setting

# IDE
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Signed files
*.jks
*.keystore

# Generated
captures/
__pycache__/
scripts/__pycache__/

# Signing (never commit keys or signing configs)
signing.properties
key.properties
*.p12
*.pfx
*.keystore.*

# Heap dumps
*.hprof

# Agent / internal tooling (not part of the app)
.workbuddy/
.tools/

# Cloudflare Worker (Plan B activation server)
worker/node_modules/
worker/.wrangler/
worker/.dev.vars          # local secrets (never commit)
worker/wrangler.toml.local

# Stray design-skill variant templates (not part of Appause)
hallmark-variants/
taste-variants/

# Generated activation codes (valid redeemable codes once seeded into KV — never commit)
worker/codes.batch.json
worker/codes.txt

# Screenshot-script debug output (root of images/screenshots/ only — keeps en/ and zh/ subdirs)
images/screenshots/*.png
images/screenshots/*.xml

# Misc local debug artifacts (never part of the app)
shot.py
db_inspect/
db2/
.gradle-user/
.android-user/
.hallmark/
